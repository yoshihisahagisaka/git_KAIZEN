NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:5173
# Provision a password for the restricted factact_runtime role locally first.
DATABASE_URL=postgresql://factact_runtime:REPLACE_ME@127.0.0.1:54322/postgres
DATABASE_SSL=false
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
# Register this exact callback with Google. Vite proxies /auth to Express locally.
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# Administrative connection is used ONLY by explicit operator binding, never the app.
# ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# OPERATOR_SUBJECT=<verified Google sub, not email>
