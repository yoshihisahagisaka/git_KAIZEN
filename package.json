{
  "name": "factact",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "packages/domain",
    "packages/application"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env apps/web/src/server/main.ts",
    "dev:ui": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && esbuild apps/web/src/server/main.ts --bundle --platform=node --packages=external --format=esm --target=node24 --outdir=dist/server",
    "start": "node dist/server/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:browser": "npm run build && playwright test",
    "db:start": "supabase start",
    "db:configure-local": "tsx --env-file=.env scripts/local-database.ts",
    "auth:verify-local": "tsx --env-file=.env scripts/verify-google-identity.ts",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "db:bind-operator": "tsx --env-file=.env scripts/bind-operator.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "supabase": "2.117.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
